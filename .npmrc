; npm must not write or delete a log file anywhere, also when it runs from another folder with --prefix.
; logs-max=0 writes no log file and makes a failed cleanup silent; logs-dir=/dev/null is not a folder,
; so the cleanup of old logs (which deletes every log beyond logs-max) finds nothing, in no folder.
; A relative logs-dir would resolve against the current folder, not the project (npm @npmcli/config parse-field.js).
; For a debug log of one command: npm --logs-dir=/tmp/npm-logs --logs-max=5 <command>
logs-dir=/dev/null
logs-max=0
update-notifier=false
